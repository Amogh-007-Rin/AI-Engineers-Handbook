{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-engineers-handbook/content.schema.json",
  "title": "AI Engineers Handbook content metadata",
  "type": "object",
  "required": [
    "title",
    "slug",
    "level",
    "stage",
    "estimated_hours",
    "prerequisites",
    "learning_objectives",
    "formats",
    "compute",
    "status",
    "last_verified"
  ],
  "properties": {
    "title": {"type": "string", "minLength": 3},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "level": {"enum": ["foundation", "practitioner", "advanced", "maintainer"]},
    "stage": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "estimated_hours": {"type": "number", "exclusiveMinimum": 0},
    "prerequisites": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "learning_objectives": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 8}
    },
    "formats": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["lesson", "notebook", "exercise", "project", "assessment", "reference"]},
      "uniqueItems": true
    },
    "compute": {"enum": ["cpu", "free-gpu", "gpu-optional", "external-service"]},
    "status": {"enum": ["outline", "draft", "review", "published", "maintenance"]},
    "last_verified": {"type": "string", "format": "date"},
    "library": {"type": "string"},
    "supported_versions": {"type": "string"}
  },
  "additionalProperties": false
}
